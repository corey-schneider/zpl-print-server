# ZPL Print Server Configuration

# === ENCRYPTION ===
# Generate a persistent encryption key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key MUST remain the same across server restarts to decrypt saved credentials
ENCRYPTION_KEY=

# === CLOUDFLARE TUNNEL ===
# Get this token from: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone:Read, Account:Read
CLOUDFLARE_TUNNEL_TOKEN=
